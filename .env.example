# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom OpenAI-compatible endpoint (leave empty for default OpenAI)
OPENAI_BASE_URL=

# Optional: Override the default chat model (default: gpt-4o-mini)
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional: Override the default embedding model (default: text-embedding-3-small)
OPENAI_EMBED_MODEL=text-embedding-3-small
